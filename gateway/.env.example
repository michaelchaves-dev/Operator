# Operator gateway env — copy to the HOST's secret env, never commit real values.
# .env itself is gitignored. Secrets never travel in SMS and never in the repo.

# Your cell number(s), comma-separated. Only these numbers may use Operator.
OPERATOR_ALLOWLIST=+1XXXXXXXXXX

# Outbound / the Operator number you bought from the provider.
OPERATOR_FROM_NUMBER=+1XXXXXXXXXX

# Provider — pick ONE to start. Telnyx recommended (cheaper); Twilio supported.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: lets private GitHub repos answer Tier 0 status.
# Use a fine-grained, read-only token scoped to the wired repos only.
GITHUB_TOKEN=

# Required for POST /notify (Operator texts you). Long random string.
OPERATOR_NOTIFY_TOKEN=

# Audit log path on the host (default: gateway/audit.jsonl).
OPERATOR_AUDIT_LOG=

# Local development ONLY — skips provider signature checks. Never 1 in production.
OPERATOR_DEV_MODE=0
